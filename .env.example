# ChipVerify AI Studio — example environment file
# Copy to backend/.env (or set in your shell) and fill in what you need.

# --- Backend ---
CHIPVERIFY_BACKEND_HOST=127.0.0.1
CHIPVERIFY_BACKEND_PORT=7348
# Secret used to sign local auth JWTs. Change this to any long random string.
CHIPVERIFY_SECRET_KEY=change-me-to-a-long-random-string
# Allow unauthenticated local desktop single-user mode (default false).
CHIPVERIFY_ALLOW_DEV_AUTH=true

# --- LLM provider ---
# One of: gemini | openai | azure_openai | nim | local
CHIPVERIFY_LLM_PROVIDER=openai
MODEL_PROVIDER=openai

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
MODEL_NAME=gpt-4o
CHIPVERIFY_LLM_MODEL_ALIAS=gpt-4o
CHIPVERIFY_LLM_API_KEY=
CHIPVERIFY_LLM_BASE_URL=https://api.openai.com/v1

# Gemini
# GOOGLE_API_KEY=

# Azure OpenAI-compatible deployment
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_STYLE=deployment
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_AUTH_HEADER=api-key
# AZURE_OPENAI_API_KEY=

# NVIDIA NIM
# NIM_API_KEY=

# Local GGUF runtime (llama.cpp llama-server)
# CHIPVERIFY_GGUF_PATH=C:\path\to\model.gguf
# CHIPVERIFY_LLAMACPP_BIN=C:\path\to\llama-server.exe

# --- RTL tooling ---
# Full path to the Slang SystemVerilog CLI if not on PATH
# CHIPVERIFY_SLANG_BIN=C:\tools\slang.exe
# Set to 1 to disable the regex fallback parser and require Slang
# CHIPVERIFY_REQUIRE_SLANG=0

# --- Demo behavior ---
# When "true", unresolved mental-model questions warn instead of blocking planning
CHIPVERIFY_DEMO_RELAX_MENTAL_MODEL_GATES=true
