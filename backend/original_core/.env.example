# Provider switch for testing: local | gemini | nim | openai | azure_openai
# Example: CHIPVERIFY_LLM_PROVIDER=gemini
CHIPVERIFY_LLM_PROVIDER=gemini
CHIPVERIFY_ALLOW_LOCAL_LLM=false

# Base URL and model (used by local/nim/openai providers)
CHIPVERIFY_LLM_BASE_URL=http://127.0.0.1:7349/v1
CHIPVERIFY_LLM_MODEL_ALIAS=moonshotai/kimi-k2-instruct

# API key for local/nim/openai compatible providers
CHIPVERIFY_LLM_API_KEY=
CHIPVERIFY_LLM_API_KEY_REQUIRED=true

# Compatibility aliases also supported by config.py:
# MODEL_PROVIDER, MODEL_NAME, OPENAI_API_BASE, OPENAI_API_KEY, NIM_API_BASE, NIM_API_KEY

# Gemini provider settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# NVIDIA NIM testing examples:
# CHIPVERIFY_LLM_PROVIDER=nim
# CHIPVERIFY_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# CHIPVERIFY_LLM_MODEL_ALIAS=moonshotai/kimi-k2-instruct
# CHIPVERIFY_LLM_API_KEY=<your_nim_api_key>

# Gemini testing examples:
# CHIPVERIFY_LLM_PROVIDER=gemini
# GEMINI_API_KEY=<your_gemini_api_key>
# GEMINI_MODEL=gemini-2.5-pro

# Azure AI Foundry / Azure OpenAI-compatible testing examples:
# CHIPVERIFY_LLM_PROVIDER=azure_openai
# MODEL_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://chipix-resource.services.ai.azure.com/openai/v1
# AZURE_OPENAI_DEPLOYMENT=DeepSeek-V4-Flash
# AZURE_OPENAI_API_STYLE=deployment
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_AUTH_HEADER=api-key
# AZURE_OPENAI_API_KEY=<your_azure_api_key>
# Optional AAD auth instead of API key:
# AZURE_OPENAI_USE_AAD=true
# AZURE_OPENAI_TOKEN_SCOPE=https://ai.azure.com/.default

CHIPVERIFY_ALLOW_PUBLIC_BIND=false
CHIPVERIFY_LLM_TIMEOUT_SECONDS=300
OUTPUT_DIR=output
MAX_ITERATIONS=10
LOG_LEVEL=INFO
DEFAULT_SIMULATOR=icarus
SIMULATION_TIMEOUT=300
