# Required
CHIPVERIFY_GGUF_PATH=C:\chipverify\models\qwen-3.5-2b-verilog-h100-fullft-v2.Q4_K_M.gguf
CHIPVERIFY_SECRET_KEY=<set-non-default-secret>
CHIPVERIFY_LLM_API_KEY=<set-runtime-api-key>

# Runtime binary locations
CHIPVERIFY_LLAMACPP_BIN=C:\chipverify\backend\runtime\bin\llama-server.exe
CHIPVERIFY_PYTHON_BIN=C:\chipverify\backend\.venv\Scripts\python.exe

# Local bind defaults (recommended)
CHIPVERIFY_LLM_BIND_HOST=127.0.0.1
CHIPVERIFY_LLM_PORT=7349
CHIPVERIFY_BACKEND_HOST=127.0.0.1
CHIPVERIFY_BACKEND_PORT=7348

# Frontend/API policy
CHIPVERIFY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CHIPVERIFY_ALLOW_PUBLIC_BIND=false
CHIPVERIFY_LLM_API_KEY_REQUIRED=true

# Backend-only service mode (install_chipverify_service.ps1 -Mode backend-exe)
# Keep these aligned with the local runtime contract when backend is managed separately.
# CHIPVERIFY_LLM_PROVIDER=local
# CHIPVERIFY_LLM_BASE_URL=http://127.0.0.1:7349/v1
# CHIPVERIFY_LLM_MODEL_ALIAS=chipix-v0.1

# Azure AI Foundry / Azure OpenAI-compatible provider:
# CHIPVERIFY_LLM_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://chipix-resource.services.ai.azure.com/openai/v1
# AZURE_OPENAI_DEPLOYMENT=DeepSeek-V4-Flash
# AZURE_OPENAI_API_STYLE=deployment
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_AUTH_HEADER=api-key
# AZURE_OPENAI_API_KEY=<your-azure-api-key>
# Optional AAD auth:
# AZURE_OPENAI_USE_AAD=true
# AZURE_OPENAI_TOKEN_SCOPE=https://ai.azure.com/.default

# Official OpenAI provider:
# CHIPVERIFY_LLM_PROVIDER=openai
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-5.4
# CHIPVERIFY_LLM_MODEL_ALIAS=gpt-5.4
# OPENAI_API_KEY=<your-openai-api-key>
# OPENAI_API_BASE=https://api.openai.com/v1
# CHIPVERIFY_LLM_API_KEY=<your-openai-api-key>
# CHIPVERIFY_LLM_BASE_URL=https://api.openai.com/v1

# Convex cloud-controlled provider:
# Provider API keys are stored in Convex environment variables, not in this file.
# CHIPVERIFY_LLM_PROVIDER=convex_gateway
# MODEL_PROVIDER=convex_gateway
# MODEL_NAME=gpt-5.4
# CHIPVERIFY_CONVEX_SITE_URL=https://<your-convex-site>.convex.site
# CHIPVERIFY_CONVEX_LLM_GATEWAY_URL=https://<your-convex-site>.convex.site/api/llm/generate
# CHIPVERIFY_LLM_API_KEY_REQUIRED=false

# Desktop managed endpoint policy should match backend host/port:
# CHIPVERIFY_BACKEND_URL=http://127.0.0.1:7348
