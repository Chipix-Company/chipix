# Demo-only local env — copy to backend/.env.demo or export in shell.
# No remote LLM. Do not put production secrets here.

CHIPVERIFY_DEMO_MODE=true
CHIPVERIFY_LLM_PROVIDER=demo
MODEL_PROVIDER=demo
CHIPVERIFY_DEMO_RELAX_MENTAL_MODEL_GATES=true
CHIPVERIFY_DEMO_SCENARIO=sha256_fix_loop
CHIPVERIFY_ALLOW_DEV_AUTH=true
CHIPVERIFY_DEMO_THINK_MS=160
CHIPVERIFY_SECRET_KEY=chipverify-local-secret-demo
CHIPVERIFY_LLM_API_KEY_REQUIRED=false
