# Production backend base URL (DO NOT append /api/v1)
VITE_API_URL=https://chipverify.example.com

# PostHog product analytics (optional — omit for local dev)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error tracking (optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
VITE_SENTRY_RELEASE=
VITE_APP_VERSION=0.2.0-beta

# UserJot feedback, roadmap, and changelog (optional)
# Project ID from https://app.userjot.com — enables in-app feedback widget
VITE_USERJOT_PROJECT_ID=cmozf9e7t0oxr0ink4c81gb7j
# Public board URL for deep links (e.g. https://yourproject.userjot.com)
VITE_USERJOT_PUBLIC_URL=https://chipix.userjot.com/
